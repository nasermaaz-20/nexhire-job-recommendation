generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Locations {
  id        BigInt   @id @default(autoincrement())
  country   String
  city      String
  createdAt DateTime @default(now()) @map("created_at")

  usersCurrentLocation Users[]        @relation("UserCurrentLocation")
  companies            Companies[]
  jobs                 Jobs[]
  userPreferred        UserPreferredLocations[]

  @@map("locations")
}

model Fields {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  skills           Skills[]
  users            Users[]
  jobs             Jobs[]
  userPreferences  UserPreferences[]

  @@map("fields")
}

model Skills {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  fieldId   BigInt?  @map("field_id")
  createdAt DateTime @default(now()) @map("created_at")

  field      Fields?      @relation(fields: [fieldId], references: [id])
  userSkills UserSkills[]
  jobSkills  JobSkills[]

  @@map("skills")
}

model Companies {
  id           BigInt   @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  industry     Int
  companySize  Int      @map("company_size")
  locationId   BigInt?  @map("location_id")
  foundedYear  Int?     @map("founded_year")
  website      String?
  isVerified   Int      @default(0) @map("is_verified")
  isActive     Int      @default(1) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  location    Locations?                  @relation(fields: [locationId], references: [id])
  jobs        Jobs[]
  interactions CompanyCandidateInteractions[]
  applications Applications[]

  @@map("companies")
}

model Users {
  id                  BigInt   @id @default(autoincrement())
  name                String
  email               String   @unique
  passwordHash        String   @map("password_hash")
  role                String   @default("job_seeker")
  yearsOfExperience   Int      @default(0) @map("years_of_experience")
  careerLevel         Int      @map("career_level")
  fieldId             BigInt?  @map("field_id")
  currentLocationId   BigInt?  @map("current_location_id")
  desiredSalaryMin    Int?     @map("desired_salary_min")
  desiredSalaryMax    Int?     @map("desired_salary_max")
  isActive            Int      @default(1) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @map("updated_at")

  field                Fields?                  @relation(fields: [fieldId], references: [id])
  currentLocation      Locations?               @relation("UserCurrentLocation", fields: [currentLocationId], references: [id])
  skills               UserSkills[]
  preferences          UserPreferences?
  preferredLocations   UserPreferredLocations[]
  interactions         Interactions[]
  companyInteractions  CompanyCandidateInteractions[]
  applications         Applications[]

  @@map("users")
}

model Jobs {
  id              BigInt   @id @default(autoincrement())
  companyId       BigInt   @map("company_id")
  title           String
  fieldId         BigInt   @map("field_id")
  jobLevel        Int      @map("job_level")
  locationId      BigInt?  @map("location_id")
  minExperience   Int?     @map("min_experience")
  maxExperience   Int?     @map("max_experience")
  salaryMin       Int?     @map("salary_min")
  salaryMax       Int?     @map("salary_max")
  employmentType  Int      @map("employment_type")
  remoteOption    Int      @map("remote_option")
  isActive        Int      @default(1) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  expiresAt       DateTime? @map("expires_at")

  company        Companies  @relation(fields: [companyId], references: [id])
  field          Fields     @relation(fields: [fieldId], references: [id])
  location       Locations? @relation(fields: [locationId], references: [id])
  skills         JobSkills[]
  interactions   Interactions[]
  applications   Applications[]
  companyInteractions CompanyCandidateInteractions[]

  @@map("jobs")
}

model UserSkills {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  skillId   BigInt   @map("skill_id")
  level     Int
  createdAt DateTime @default(now()) @map("created_at")

  user  Users  @relation(fields: [userId], references: [id])
  skill Skills @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId], map: "uq_user_skills")
  @@map("user_skills")
}

model JobSkills {
  id          BigInt   @id @default(autoincrement())
  jobId       BigInt   @map("job_id")
  skillId     BigInt   @map("skill_id")
  importance  Int
  isRequired  Int      @default(1) @map("is_required")
  createdAt   DateTime @default(now()) @map("created_at")

  job   Jobs   @relation(fields: [jobId], references: [id])
  skill Skills @relation(fields: [skillId], references: [id])

  @@unique([jobId, skillId], map: "uq_job_skills")
  @@map("job_skills")
}

model UserPreferences {
  id                       BigInt   @id @default(autoincrement())
  userId                   BigInt   @unique @map("user_id")
  preferredFieldId         BigInt?  @map("preferred_field_id")
  preferredJobLevel        Int?     @map("preferred_job_level")
  preferredEmploymentType  Int?     @map("preferred_employment_type")
  remotePreference         Int?     @map("remote_preference")
  minSalary                Int?     @map("min_salary")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @default(now()) @map("updated_at")

  user   Users  @relation(fields: [userId], references: [id])
  field  Fields? @relation(fields: [preferredFieldId], references: [id])

  @@map("user_preferences")
}

model UserPreferredLocations {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  locationId BigInt   @map("location_id")
  priority   Int
  createdAt  DateTime @default(now()) @map("created_at")

  user     Users     @relation(fields: [userId], references: [id])
  location Locations @relation(fields: [locationId], references: [id])

  @@unique([userId, locationId], map: "uq_user_preferred_locations")
  @@map("user_preferred_locations")
}

model Interactions {
  id              BigInt   @id @default(autoincrement())
  userId          BigInt   @map("user_id")
  jobId           BigInt   @map("job_id")
  interactionType Int      @map("interaction_type")
  createdAt       DateTime @default(now()) @map("created_at")

  user Users @relation(fields: [userId], references: [id])
  job  Jobs  @relation(fields: [jobId], references: [id])

  @@map("interactions")
}

model CompanyCandidateInteractions {
  id              BigInt   @id @default(autoincrement())
  companyId       BigInt   @map("company_id")
  userId          BigInt   @map("user_id")
  jobId           BigInt?  @map("job_id")
  interactionType Int      @map("interaction_type")
  createdAt       DateTime @default(now()) @map("created_at")

  company Companies @relation(fields: [companyId], references: [id])
  user    Users     @relation(fields: [userId], references: [id])
  job     Jobs?     @relation(fields: [jobId], references: [id])

  @@map("company_candidate_interactions")
}

model Applications {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  jobId      BigInt   @map("job_id")
  companyId  BigInt   @map("company_id")
  status     Int
  appliedAt  DateTime @default(now()) @map("applied_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  user    Users     @relation(fields: [userId], references: [id])
  job     Jobs      @relation(fields: [jobId], references: [id])
  company Companies @relation(fields: [companyId], references: [id])


  @@unique([userId, jobId], map: "uq_applications_user_job")
  @@map("applications")
}

